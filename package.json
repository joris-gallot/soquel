{
  "name": "soquel",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "description": "Next generation database client",
  "engines": {
    "node": "26.3.1"
  },
  "scripts": {
    "dev:app": "pnpm --filter @soquel/app dev",
    "dev": "tauri dev",
    "dev:wsl": "SOQUEL_EPHEMERAL_SECRETS=1 tauri dev",
    "build": "pnpm -r build",
    "build:desktop": "tauri build",
    "tauri": "tauri",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "pnpm -r test",
    "test:integration": "SOQUEL_TEST_PG=postgres://soquel:soquel@localhost:5455/soquel_test cargo test --manifest-path src-tauri/Cargo.toml integration_",
    "test:e2e": "pnpm -r test:e2e",
    "db:test": "docker compose -f docker-compose.test.yml up -d --wait",
    "db:test:down": "docker compose -f docker-compose.test.yml down"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "@tauri-apps/cli": "^2.11.4",
    "eslint": "^10.5.0",
    "typescript": "~6.0.3"
  }
}
