---
// A product screenshot, or the frame waiting for one. The placeholder carries
// its own capture spec so the slot cannot be deployed by accident and so the
// shot gets taken right the first time.
interface Props {
  src?: string
  alt: string
  caption: string
  spec: string
}

const { src, alt, caption, spec } = Astro.props
---

<figure class="m-0">
  {
    src
      ? (
          <img
            src={src}
            alt={alt}
            width="1440"
            height="900"
            loading="lazy"
            decoding="async"
            class="rounded-card border border-rule w-full"
          />
        )
      : (
          <div
            class="rounded-card border border-rule flex aspect-[16/10] w-full flex-col items-center justify-center gap-2 border-dashed px-6 text-center"
          >
            <p class="label">Placeholder</p>
            <p class="font-mono text-xs text-mute">{spec}</p>
          </div>
        )
  }
  <figcaption class="mt-3 text-sm text-mute">{caption}</figcaption>
</figure>
