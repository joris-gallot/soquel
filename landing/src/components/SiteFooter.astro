---
import { SITE } from '@/lib/site'
---

<footer
  class="flex flex-wrap items-center justify-between gap-3 border-t border-rule py-8 font-mono text-xs text-mute"
>
  <span>Offline by design, no telemetry.</span>
  <nav class="flex items-center gap-4">
    <a href="/privacy" class="underline-offset-4 hover:text-ink hover:underline">Privacy</a>
    <a
      href={SITE.repo}
      target="_blank"
      rel="noopener"
      aria-label="soquel source on GitHub"
      class="underline-offset-4 hover:text-ink hover:underline"
    >GitHub</a
    >
  </nav>
</footer>
