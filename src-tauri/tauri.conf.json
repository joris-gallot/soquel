{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "soquel",
  "version": "0.1.0",
  "identifier": "dev.soquel.app",
  "build": {
    "frontendDist": "../packages/app/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @soquel/app dev",
    "beforeBuildCommand": "pnpm --filter @soquel/app build"
  },
  "app": {
    "windows": [
      {
        "title": "Soquel",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
